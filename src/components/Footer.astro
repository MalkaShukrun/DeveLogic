---
import Brand from './Brand.astro';

const year = new Date().getFullYear();

// Same sections as the header nav. Root-relative so they also work from /privacy.
const links = [
  { href: '/#contact', label: 'צור קשר' },
];
---

<footer>
  <div class="page-shell footer-top">
    <div class="footer-brand">
      <div class="brand-lockup">
        <Brand dark />
        <span class="brand-tagline">SOFTWARE &amp; AI</span>
      </div>
      <p>
        DeveLogic בונה תוכנה ופתרונות AI בהתאמה אישית שחוסכים לעסקים זמן ועוזרים להם לצמוח, עם יותר מ־11 שנות ניסיון
        הנדסי.
      </p>
    </div>

    <nav class="footer-nav" aria-labelledby="footer-nav-heading">
      <h2 class="footer-heading" id="footer-nav-heading">ניווט</h2>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="page-shell footer-bottom">
    <a href="/privacy">מדיניות פרטיות</a>
    <span>© {year} DeveLogic כל הזכויות שמורות.</span>
  </div>
</footer>
