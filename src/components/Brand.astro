---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---

<a class:list={['brand', { 'brand-dark': dark }]} href="#home" aria-label="DeveLogic">
  <svg aria-hidden="true" class="brand-mark" fill="none" viewBox="0 0 28.6 39" xmlns="http://www.w3.org/2000/svg">
    <rect x="4.95" y="4.95" width="18.7" height="18.7" rx="2" transform="rotate(45 14.3 14.3)" />
    <rect x="4.95" y="15.35" width="18.7" height="18.7" rx="2" transform="rotate(45 14.3 24.7)" />
  </svg>
  <span>DeveLogic</span>
</a>
