---
import Icon from './Icon.astro';
---

<section class="contact" id="contact">
  <div class="page-shell contact-grid">
    <div class="contact-copy">
      <p class="kicker kicker-light">יצירת קשר</p>
      <h2>יש לכם אתגר? בואו נפתור אותו.</h2>
      <p>ספרו לנו בקצרה על המטרות שלכם. נחזור אליכם כדי לבחון את הדרך הטכנולוגית הנכונה.</p>
    </div>

    <div class="contact-form">
      <form id="contact-form" novalidate>
        <div class="form-heading">
          <h3>טופס פנייה</h3>
        </div>
        <div class="form-row">
          <label>
            שם מלא
            <input type="text" name="name" autocomplete="name" required minlength="2" maxlength="100" />
          </label>
          <label>
            אימייל
            <input type="email" name="email" autocomplete="email" required maxlength="150" />
          </label>
        </div>
        <label>
          מספר טלפון
          <input type="tel" name="phone" autocomplete="tel" maxlength="20" />
        </label>
        <label>
          פרטי הפרויקט <span>(רשות)</span>
          <textarea name="message" rows="5" maxlength="3000"></textarea>
        </label>
        <!-- Honeypot: hidden from people, filled in by bots -->
        <input class="hp-field" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="form-error" role="alert" hidden></p>
        <button class="button button-submit" type="submit">
          <span class="submit-label">תיאום שיחת ייעוץ</span>
          <Icon name="arrow" size={19} />
        </button>
      </form>

      <div class="success-message" role="status" hidden>
        <span><Icon name="check" size={28} /></span>
        <h3>תודה שפניתם אלינו.</h3>
        <p>פרטי הפרויקט התקבלו. נהיה איתכם בקשר בקרוב.</p>
        <button type="button" class="text-link" data-reset>שליחת הודעה נוספת</button>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const success = document.querySelector<HTMLElement>('.success-message')!;
  const errorBox = form.querySelector<HTMLElement>('.form-error')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const submitLabel = submit.querySelector<HTMLElement>('.submit-label')!;
  const defaultLabel = submitLabel.textContent;

  function showError(message: string) {
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.hidden = true;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submit.disabled = true;
    submitLabel.textContent = 'שולחים...';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.success) {
        showError(data.error ?? 'שליחת ההודעה נכשלה. נסו שוב מאוחר יותר.');
        return;
      }

      form.reset();
      form.hidden = true;
      success.hidden = false;
    } catch {
      showError('אין חיבור לשרת. בדקו את החיבור ונסו שוב.');
    } finally {
      submit.disabled = false;
      submitLabel.textContent = defaultLabel;
    }
  });

  success.querySelector('[data-reset]')!.addEventListener('click', () => {
    success.hidden = true;
    form.hidden = false;
  });
</script>
