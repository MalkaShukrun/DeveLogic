---
import Icon, { type IconName } from './Icon.astro';

const services: { icon: IconName; number: string; title: string; copy: string; tags: string[] }[] = [
  {
    icon: 'code',
    number: '01',
    title: 'פיתוח תוכנה בהתאמה אישית',
    copy: 'כשכלי מדף לא מתאימים לאופן שבו אתם עובדים. אפליקציות Web ומוצרים דיגיטליים שנבנים סביב התהליכים שלכם, כדי שהעבודה תזרום במקום להיתקע.',
    tags: ['פלטפורמות Web', 'הנדסת מוצר'],
  },
  {
    icon: 'spark',
    number: '02',
    title: 'פתרונות AI ואוטומציה',
    copy: 'כשהצוות שלכם מבזבז שעות על משימות שחוזרות על עצמן. אוטומציה ורכיבי AI שעושים את העבודה השגרתית, כדי שתתפנו למה שמקדם את העסק.',
    tags: ['אינטגרציית AI', 'אוטומציית תהליכים'],
  },
  {
    icon: 'strategy',
    number: '03',
    title: 'אסטרטגיה וארכיטקטורה טכנולוגית',
    copy: 'כשצריך להחליט איך לבנות, ולא רוצים לגלות טעות אחרי שנה. ליווי טכנולוגי שעוזר לבחור נכון מההתחלה ולחסוך את העלות של תיקונים בהמשך.',
    tags: ['ביקורת טכנולוגית', 'ארכיטקטורה'],
  },
];
---

<section class="section services" id="services">
  <div class="page-shell">
    <div class="section-heading">
      <div>
        <p class="kicker">איך נוכל לעזור</p>
        <h2>מתחילים מהאתגר שלכם.<br />בונים את מה שפותר אותו.</h2>
      </div>
    </div>
    <div class="service-grid">
      {
        services.map((service) => (
          <article class="service-card">
            <div class="card-top">
              <span class="icon-box">
                <Icon name={service.icon} size={23} />
              </span>
              <span class="card-number">{service.number}</span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
            <div class="tags">
              {service.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
