---
import Icon, { type IconName } from './Icon.astro';

const principles: { icon: IconName; title: string; copy: string }[] = [
  {
    icon: 'layers',
    title: 'ארכיטקטורה ויציבות לטווח ארוך',
    copy: 'תשתית מתוכננת היטב, כך שהמערכת ממשיכה לעבוד חלק גם כשמספר המשתמשים וכמות הנתונים גדלים.',
  },
  {
    icon: 'shield',
    title: 'אבטחה והגנה מקיפה',
    copy: 'הצפנה, ניהול הרשאות מבוקר ומנגנוני אבטחה קפדניים, כדי שהמידע שלכם ושל הלקוחות שלכם יישאר מוגן.',
  },
  {
    icon: 'database',
    title: 'מבנה נתונים אופטימלי',
    copy: 'בסיס נתונים שמתוכנן נכון מההתחלה, כדי שתמצאו מידע במהירות והמערכת לא תאט עם הזמן.',
  },
  {
    icon: 'expand',
    title: 'גמישות ויכולת התאמה מלאה',
    copy: 'קוד נקי ומודולרי, כך שכשהעסק משתנה אפשר להוסיף פיצ׳רים ולבצע שינויים בלי לבנות הכול מחדש.',
  },
  {
    icon: 'monitor',
    title: 'חוויית משתמש ונגישות',
    copy: 'התאמה לכל מסך, בדגש על מובייל, עיצוב נגיש וזמני טעינה מהירים, כדי שהמשתמשים שלכם יעבדו בנוחות ולא יוותרו באמצע.',
  },
  {
    icon: 'refresh',
    title: 'תחזוקה ואמינות גבוהה',
    copy: 'טיפול מבוקר בשגיאות, גיבויים אוטומטיים ואחריות מקצה לקצה, כדי שתוכלו לסמוך על המערכת ביום־יום.',
  },
];
---

<section class="engineering" id="engineering">
  <div class="page-shell">
    <div class="engineering-heading">
      <div>
        <p class="kicker">הסטנדרט ההנדסי שלנו</p>
        <h2>מערכות שנבנות נכון,<br />מהיסוד</h2>
      </div>
      <p>
        מה זה אומר בשבילכם? פחות תקלות, פחות הפתעות, ומערכת שאפשר להמשיך לבנות עליה גם בעוד כמה שנים.
      </p>
    </div>
    <div class="principles-grid">
      {
        principles.map((principle) => (
          <article class="principle">
            <div class="principle-icon">
              <Icon name={principle.icon} size={22} />
            </div>
            <div class="principle-copy">
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
