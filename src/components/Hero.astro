---
import Brand from './Brand.astro';
import Icon, { type IconName } from './Icon.astro';

const steps: { icon: IconName; number: string; title: string; copy: string }[] = [
  {
    icon: 'strategy',
    number: '01',
    title: 'אפיון ואסטרטגיה',
    copy: 'מתחילים מהבעיה העסקית שלכם: מה מעכב, מה חשוב לכם ואיך תיראה הצלחה. רק אז מגדירים את הפתרון.',
  },
  {
    icon: 'code',
    number: '02',
    title: 'פיתוח ואינטגרציה',
    copy: 'בונים את הפתרון ומחברים אותו לכלים שכבר עובדים אצלכם, עם AI ואוטומציה במקומות שבהם הם חוסכים זמן.',
  },
  {
    icon: 'expand',
    number: '03',
    title: 'השקה וצמיחה',
    copy: 'עולים לאוויר עם מערכת יציבה ומאובטחת, שמוכנה לגדול יחד עם העסק שלכם.',
  },
];
---

<section class="hero" id="home">
  <nav class="nav page-shell" aria-label="DeveLogic">
    <ul class="nav-links">
      <li><a class="nav-cta" href="#contact">צור קשר</a></li>
    </ul>
    <div class="brand-lockup">
      <Brand />
      <span class="brand-tagline">SOFTWARE &amp; AI</span>
    </div>
  </nav>

  <div class="hero-grid page-shell">
    <div class="hero-copy">
      <h1>תוכנה ו-AI שעובדים <span>בשביל העסק שלכם</span></h1>
      <p class="hero-lede">
        עבודה ידנית שגוזלת שעות? מערכות שלא מדברות זו עם זו? רעיון למוצר שלא ברור מאיפה להתחיל? אנחנו בונים תוכנה,
        פתרונות AI וסוכנים חכמים (AI Agents) בהתאמה אישית, שחוסכים לכם זמן ועוזרים לעסק לצמוח, מהאפיון ועד למוצר
        המוגמר.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">
          תיאום שיחת ייעוץ חינם
          <Icon name="arrow" size={19} />
        </a>
      </div>
    </div>

    <ol class="process-row" aria-label="תהליך העבודה איתנו">
      {
        steps.map((step) => (
          <li>
            <span class="process-icon">
              <Icon name={step.icon} size={20} />
            </span>
            <small>שלב {step.number}</small>
            <strong>{step.title}</strong>
            <p>{step.copy}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
