---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
---

<section class="hero" id="home">
  <nav class="nav page-shell" aria-label="DeveLogic">
    <div class="brand-lockup">
      <Brand />
      <span class="brand-tagline">SOFTWARE &amp; AI</span>
    </div>
  </nav>

  <div class="hero-grid page-shell">
    <div class="hero-copy">
      <h1>פתרונות טכנולוגיים ו-<span>AI מקצה לקצה</span></h1>
      <p class="hero-lede">
        הופכים אתגרים עסקיים מורכבים לתוכנה מותאמת אישית, פתרונות בינה מלאכותית, סוכנים חכמים (AI Agents) ותשתיות
        יציבות, משלב האפיון והתכנון ועד למוצר המוגמר.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">
          תיאום שיחת ייעוץ
          <Icon name="arrow" size={19} />
        </a>
        <a class="text-link" href="#services">גלו את הפתרונות שלנו</a>
      </div>
      <div class="trust-row">
        <div>
          <strong>פיתוח מותאם אישית</strong>
          <span>לא מוצר מדף</span>
        </div>
        <div>
          <strong>מעטפת מלאה</strong>
          <span>משלב האפיון והתכנון ועד למוצר המוגמר</span>
        </div>
        <div>
          <strong>ארכיטקטורה מתקדמת</strong>
          <span>מותאמת לצמיחה בהיקף הפעילות</span>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-label="מפת הפתרון">
      <div class="blueprint-header">
        <div>
          <strong>מפת הפתרון</strong>
        </div>
        <span class="blueprint-status"><i></i> מתכנון מדויק ועד מוצר מוגמר</span>
      </div>

      <div class="solution-flow">
        <div class="flow-step">
          <span class="step-icon"><Icon name="strategy" size={20} /></span>
          <div>
            <small>שלב 01</small>
            <strong>אפיון ואסטרטגיה</strong>
            <p>מבינים לעומק את המטרות העסקיות, מנתחים את צורכי המשתמשים ומגדירים את ארכיטקטורת הפתרון.</p>
          </div>
          <span class="step-check"><Icon name="check" size={15} /></span>
        </div>

        <div class="flow-connector"><span></span></div>

        <div class="flow-step flow-step-active">
          <span class="step-icon"><Icon name="code" size={21} /></span>
          <div>
            <small>שלב 02</small>
            <strong>פיתוח ואינטגרציה</strong>
            <p>בונים פתרון מדויק מקצה לקצה תוך שילוב טכנולוגיות תוכנה, רכיבי AI ותהליכי אוטומציה חכמים.</p>
          </div>
          <span class="active-pulse"></span>
        </div>

        <div class="flow-connector"><span></span></div>

        <div class="flow-step">
          <span class="step-icon"><Icon name="expand" size={20} /></span>
          <div>
            <small>שלב 03</small>
            <strong>השקה וצמיחה</strong>
            <p>מעלים לאוויר מערכת מאובטחת ויציבה, המוכנה להתרחבות עתידית ולעבודה בהיקפים גדלים.</p>
          </div>
          <span class="step-check step-check-muted"><Icon name="check" size={15} /></span>
        </div>
      </div>
    </div>
  </div>
</section>
